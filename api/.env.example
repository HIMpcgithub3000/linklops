# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored and must never be committed.
#
# This file is the contract, and it is enforced in three directions at import
# (see app/config.py): every key here must be supplied, every supplied key must
# appear here, and every key here must correspond to a Settings field.

# --- live in Module 1 -------------------------------------------------------
# Must be 1024-65535. See app/config.py for why the bounds are not 1-65535.
PORT=8000

# development | staging | production. Gates the dev-only tenant header in
# app/db.py -- anything but "development" refuses to honour it.
ENVIRONMENT=development

# --- live in Module 2: persistence ------------------------------------------
# The application connects as upsk_app: NOBYPASSRLS, no table ownership, so
# row-level security actually applies to it.
DATABASE_URL=postgresql+psycopg://upsk_app:upsk_app_pw@127.0.0.1:5433/linkops

# Alembic connects as the owner. Kept separate on purpose: an app that shares
# the migration credential owns its tables, and table owners bypass RLS.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/linkops

# Host port is 55432, not 5432: something native already owns 5432 on this
# machine. A per-project dev container should not squat the default port.

# --- live in Module 3: public API -------------------------------------------
# The origin short links are handed out under. Configured, never derived from
# the request Host header -- see app/config.py for why that is a phishing vector.
PUBLIC_BASE_URL=http://localhost:8000

# --- not live yet -----------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/shortener

# Module 6: cache
REDIS_URL=redis://localhost:6379

# Module 4: auth
JWT_SECRET=replace-with-a-long-random-string
API_KEY_A=replace-with-tenant-a-key
API_KEY_B=replace-with-tenant-b-key

# debug | info | warning | error. Minimal by default; raise to debug to investigate.
LOG_LEVEL=info
